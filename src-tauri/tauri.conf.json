{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinta e Aprende",
  "version": "0.1.0",
  "identifier": "pt.pintaeaprende.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pinta e Aprende",
        "width": 1180,
        "height": 820,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#fff7e6"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Pintar e aprender palavras, para crianças pequenas.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
