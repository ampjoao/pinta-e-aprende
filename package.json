{
  "name": "pinta-e-aprende",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "capacitor-assets generate --iconBackgroundColor '#ff8a3d' --splashBackgroundColor '#fff7e6' && tauri icon assets/logo.png",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
