# Copiar para .env (nunca enviar o .env para o Git).
# Chave mestra: 64 caracteres hexadecimais. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
PORT=8787
DB_PATH=./data/mao-amiga.db
# Origens autorizadas a falar com o servidor (web, Android, iOS, Windows)
ALLOWED_ORIGINS=http://localhost:5174,https://localhost,capacitor://localhost,tauri://localhost,http://tauri.localhost
# Primeira conta de administração (criada no arranque se não existir)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Regras (valores em cêntimos)
MAX_MONTHLY_CENTS=30000
MIN_DONORS_PER_CYCLE=5
POVERTY_LINE_CENTS=63600
